{
  "AiSettings": {
    "Provider": "Claude",              // 활성화할 AI 제공자 ("OpenAI" | "Google" | "Claude" | "Ollama" | "ollama-cloud" | "mlx" | "local-openai" | "Z.ai" | "OpenRouter" | "claude-cli" | "codex-cli" | "agy-cli")
    "ModelName": "claude-sonnet-5",   // 사용할 LLM 모델명. CLI 제공자에도 그대로 적용되어 CLI의 모델 인자로 전달되며, 비워 두면 인자를 생략해 해당 CLI의 기본 모델이 쓰입니다. 이름은 API 모델 ID가 아니라 그 CLI가 받아들이는 표기여야 합니다.
    "AllowCliProviderInBatch": false,  // [설정] 무인 배치 검증(--batch)에서 CLI provider(claude-cli | codex-cli) 사용 허용 여부. 기본 false에서는 CLI provider가 지정되면 즉시 중단합니다. 이 키는 검증기 자기 설정에서만 읽으므로 분석기 쪽을 열어도 여기는 닫힌 채 남습니다. agy-cli는 이 설정으로도 허용되지 않습니다.
    "ActorEffort": "high",           // L2 검증기 AI의 추론 강도 (low | medium | high | dynamic)
    "Temperature": 0.1,                // 검증의 일관성을 위해 낮게(0.0 ~ 0.2) 설정을 권장합니다.
    "MaxL2Attempts": 2,                // L2 AI 의미론적 교차 검토 실패 시 추가로 재시도할 자가 보완 횟수 (1 이상의 정수 또는 "unlimited" 지정 시 무제한)
    "TimeoutSeconds": 3600,             // AI API 호출 시 HttpClient 타임아웃 시간 (초 단위, 기본값: 300)
    "Providers": {
      "OpenAI": {
        "ApiKey": "",                  // OpenAI API 키
        "Endpoint": "https://api.openai.com/v1"
      },
      "Google": {
        "ApiKey": "",                  // Google API 키 (Google AI Studio)
        "Endpoint": "https://generativelanguage.googleapis.com"
      },
      "Claude": {
        "ApiKey": "",                  // Claude API 키 (Claude Console)
        "Endpoint": "https://api.anthropic.com"
      },
      "Ollama": {
        "Endpoint": "http://localhost:11434" // 로컬 Ollama 엔드포인트
      },
      // Ollama Cloud(https://ollama.com). 로컬 Ollama와 같은 /api/chat 규격에
      // Bearer 인증만 더해진다. 모델은 `curl https://ollama.com/api/tags`로 확인한다.
      "ollama-cloud": {
        "ApiKey": "",                        // https://ollama.com/settings/keys 에서 발급 (필수)
        "Endpoint": "https://ollama.com"     // Ollama Cloud 엔드포인트 (/api/chat은 자동으로 붙는다)
      },
      "Z.ai": {
        "ApiKey": "",                  // Z.ai API 키
        "Endpoint": "https://api.z.ai/api"
      },
      // OpenRouter(https://openrouter.ai). 수백 종 모델을 한 엔드포인트로 중개한다.
      // [주의] ModelName은 네임스페이스가 붙은 OpenRouter 모델 ID로 적는다
      //   (예: "z-ai/glm-5.3"). 네임스페이스를 빼면 어느 벤더로 풀릴지가
      //   OpenRouter의 판단에 달려 재현성이 없다.
      // 라우팅의 근거와 후보 조회법: docs/architecture/4.5-multi-llm-provider.md
      "OpenRouter": {
        "ApiKey": "",                            // https://openrouter.ai/settings/keys 에서 발급 (필수)
        "Endpoint": "https://openrouter.ai/api/v1", // /chat/completions는 자동으로 붙는다
        "NumCtx": null,                          // 지정하면 max_tokens로 전달된다. 비워 두면 모델 기본값
        "Routing": {
          "Default": {
            // [주의] 받는 값은 닫힌 목록이다: int4·int8·fp4·mxfp4·nvfp4·fp6·fp8·mxfp8·fp16·bf16·fp32·unknown.
            // 대소문자를 구분한다 - "FP8"은 400이다(실측). 철자가 목록에 없으면
            // 400(스키마 위반), 표기는 유효한데 그 모델에 그 양자화가 없으면
            // 404(후보 0)다(실측: quantizations:["fp8x"] → 400 "Invalid option",
            // quantizations:["int4"] → 404 "No endpoints found").
            // 반경: 이 칸의 오타는 그 CLI의 모든 모델에 번진다(Order 오타는 그
            // 모델만). 두 파일을 같게 유지하는 규칙 때문에 오타는 대개 양쪽에
            // 함께 들어가고, 그러면 두 CLI가 함께 죽는다 - 다만 한쪽만 틀리면
            // AppSettings_BothCliConfigs_DeclareIdenticalOpenRouterRouting이 먼저 잡는다.
            "Quantizations": [ "fp8" ],  // 품질 하한. fp4·unknown을 원천 배제한다
            "AllowFallbacks": true       // 밖이 이미 fp8뿐이라 열어 둔다 - 미등록 모델도 죽지 않는다
          },
          "ByModel": {
            // 캐시 고착성 전용. 백엔드가 여럿인 모델에만 적는다.
            //
            // [2026-09-19] 이 항목들은 전부 AllowFallbacks:false 다. 축이 둘인데
            // 여기서는 **재현성**을 고른 것이다 - Default 는 여전히 true 라서
            // ByModel 에 없는 모델은 종전대로 폴백으로 살아난다(그 축은 안 바뀌었다).
            //
            // 근거는 실측이다. 백엔드가 섞이면 결론이 뒤집힌다 - 2026-09-13 에
            // 같은 A/B 가 백엔드를 따라 -80% → -20% → -86% 로 세 번 갈렸다.
            // AllowFallbacks 가 열려 있으면 Order 는 「선호」일 뿐이고, 1 순위가
            // 붐비는 순간 목록 **밖**으로 나가므로 판마다 다른 백엔드가 섞인다.
            //
            // **대가를 적는다**: 각 Order 의 후보가 전부 죽으면 그 요청은 폴백 없이
            // 실패한다. 가용성을 재현성과 맞바꾼 것이고, 되돌리려면 이 줄들의
            // AllowFallbacks 를 지우면 Default 의 true 를 다시 물려받는다.
            //
            // gpt-5.6-sol 에서 azure 를 지운 것은 별개 축이다 - 실측 단가가
            // openai $2/$10 대 azure $5/$30 으로 2.5~3 배다(2026-09-19 /endpoints).
            "z-ai/glm-5.3": { "Order": [ "baidu/fp8", "novita/fp8" ], "AllowFallbacks": false },
            // [예외] 아래 둘은 Order 말고 Quantizations도 적는다. Default의 fp8
            // 하한이 이 모델들에서는 후보를 0으로 만들어 404 "No endpoints found"로
            // 죽기 때문이다(실측 2026-09-10, routing_funnel: gpt-5.6-sol 7개 엔드포인트
            // 전부 unknown · qwen3.8-max-0902는 엔드포인트 1개가 unknown).
            // 벤더가 자기 모델을 직접 서빙하는 폐쇄 가중치 모델은 /endpoints가
            // 양자화를 unknown으로만 보고하므로, 여기서 unknown을 여는 것은 품질을
            // 낮추는 것이 아니라 1차 벤더 엔드포인트를 여는 것이다. 열린 범위는
            // 그 모델 항목 안에만 머문다(Merge가 항목 단위라 Default는 fp8 그대로).
            "openai/gpt-5.6-sol": { "Order": [ "openai" ], "Quantizations": [ "unknown" ], "AllowFallbacks": false },
            "qwen/qwen3.8-max-0902": { "Order": [ "alibaba" ], "Quantizations": [ "unknown" ], "AllowFallbacks": false },
            // kimi-k3은 열린 가중치라 fp8 하한이 그대로 의미가 있다 - 다만 백엔드 19개
            // 중 fp8은 baseten 하나뿐이라, 하한을 물려받는 순간 후보가 그 하나로 정해진다.
            "moonshotai/kimi-k3": { "Order": [ "baseten/fp8" ], "AllowFallbacks": false }
          }
        }
      },
      // CLI 제공자는 ApiKey 없이 Command만 씁니다. 모델은 여기가 아니라 AiSettings:ModelName이
      // 아래 인자로 전달됩니다.
      "claude-cli": {
        "Command": "claude"            // Claude Code CLI 명령어. PATH에 없으면 절대 경로 지정. API 키 불필요(CLI 로그인 계정 사용). 모델은 --model 인자로 전달
      },
      "codex-cli": {
        "Command": "codex"             // Codex CLI 명령어. 모델은 -m 인자로 전달
      },
      "agy-cli": {
        "Command": "agy"               // Antigravity CLI 명령어. 모델은 --model 인자로 전달. 프롬프트를 명령행으로 넘기므로 Windows에서 32KB를 넘는 대형 SP는 처리할 수 없음
      }
    }
  },
  "ValidationSettings": {
    "TargetLanguage": "C#"               // 검증 대상 언어 ("Auto" | "C#" | "Java")
  }
}
