{
  "AiSettings": {
    "Provider": "Claude",              // 활성화할 AI 제공자 ("OpenAI" | "Google" | "Claude" | "Ollama" | "ollama-cloud" | "mlx" | "local-openai" | "Z.ai" | "OpenRouter" | "claude-cli" | "codex-cli" | "agy-cli")
    "ModelName": "claude-sonnet-5",   // 사용할 LLM 모델명. CLI 제공자에도 그대로 적용되어 CLI의 모델 인자로 전달되며, 비워 두면 인자를 생략해 해당 CLI의 기본 모델이 쓰입니다. 이름은 API 모델 ID가 아니라 그 CLI가 받아들이는 표기여야 합니다.
    "AllowCliProviderInBatch": false,  // [설정] 무인 배치 검증(--batch)에서 CLI provider(claude-cli | codex-cli) 사용 허용 여부. 기본 false에서는 CLI provider가 지정되면 즉시 중단합니다. 이 키는 검증기 자기 설정에서만 읽으므로 분석기 쪽을 열어도 여기는 닫힌 채 남습니다. agy-cli는 이 설정으로도 허용되지 않습니다.
    "ActorEffort": "high",           // L2 검증기 AI의 추론 강도 (low | medium | high | dynamic)
    "Temperature": 0.1,                // 검증의 일관성을 위해 낮게(0.0 ~ 0.2) 설정을 권장합니다.
    "MaxL2Attempts": 2,                // L2 AI 의미론적 교차 검토 실패 시 추가로 재시도할 자가 보완 횟수 (1 이상의 정수 또는 "unlimited" 지정 시 무제한)
    "TimeoutSeconds": 3600,             // AI API 호출 시 HttpClient 타임아웃 시간 (초 단위, 기본값: 300)
    "Providers": {
      "OpenAI": {
        "ApiKey": "",                  // OpenAI API 키
        "Endpoint": "https://api.openai.com/v1"
      },
      "Google": {
        "ApiKey": "",                  // Google API 키 (Google AI Studio)
        "Endpoint": "https://generativelanguage.googleapis.com"
      },
      "Claude": {
        "ApiKey": "",                  // Claude API 키 (Claude Console)
        "Endpoint": "https://api.anthropic.com"
      },
      "Ollama": {
        "Endpoint": "http://localhost:11434" // 로컬 Ollama 엔드포인트
      },
      // Ollama Cloud(https://ollama.com). 로컬 Ollama와 같은 /api/chat 규격에
      // Bearer 인증만 더해진다. 모델은 `curl https://ollama.com/api/tags`로 확인한다.
      "ollama-cloud": {
        "ApiKey": "",                        // https://ollama.com/settings/keys 에서 발급 (필수)
        "Endpoint": "https://ollama.com"     // Ollama Cloud 엔드포인트 (/api/chat은 자동으로 붙는다)
      },
      "Z.ai": {
        "ApiKey": "",                  // Z.ai API 키
        "Endpoint": "https://api.z.ai/api"
      },
      // OpenRouter(https://openrouter.ai). 수백 종 모델을 한 엔드포인트로 중개한다.
      // [주의] ModelName은 네임스페이스가 붙은 OpenRouter 모델 ID로 적는다
      //   (예: "anthropic/claude-sonnet-5", "openai/gpt-5.6", "google/gemini-3-pro").
      //   네임스페이스를 빼도 OpenRouter가 해석하지만(실측: "claude-sonnet-5" ->
      //   anthropic/claude-sonnet-5), 어느 벤더로 풀릴지가 OpenRouter의 판단에 달려
      //   있어 재현성이 없다. 없는 이름은 400 "is not a valid model ID"로 떨어진다.
      // 프롬프트 캐싱은 모델 계열과 무관하게 자동으로 걸린다 - 같은 접두사를 두 번째
      // 보낼 때 공유 블록에 표시를 찍고, OpenRouter가 그것을 백엔드 규격으로 번역한다.
      "OpenRouter": {
        "ApiKey": "",                            // https://openrouter.ai/settings/keys 에서 발급 (필수 - 없으면 호출 시 중단)
        "Endpoint": "https://openrouter.ai/api/v1", // OpenRouter 엔드포인트 (/chat/completions는 자동으로 붙는다)
        "NumCtx": null,                          // 지정하면 max_tokens로 전달된다. 비워 두면 모델 기본값을 쓴다
        // ── 백엔드 라우팅 고정 ───────────────────────────────────────────────
        // OpenRouter는 같은 모델을 여러 백엔드가 서빙하고 호출마다 그중 하나로
        // 보낸다(z-ai/glm-5.2는 37곳). 고정하지 않으면 세 가지가 회차마다 흔들린다.
        //
        //  1) 프롬프트 캐시. 1회차에 캐시를 쓴 백엔드와 2회차가 가는 백엔드가
        //     다르면 읽지 못한다. 실측(z-ai/glm-5.2, 접두사 10,220토큰):
        //       미고정  1회차 Mistral → 2회차 DigitalOcean : 적중 0,      $0.00776
        //       고정    1회차·2회차 모두 DigitalOcean      : 적중 10,112, $0.00171 (-76%)
        //     ReSet은 같은 접두사를 Actor 후보 3종·재시도·L2 리뷰로 반복 전송하므로
        //     이 차이가 그대로 실행 비용이 된다.
        //  2) 단가. 같은 모델의 입력 단가가 백엔드에 따라 $0.50~$2.31/M로 벌어진다.
        //  3) 양자화. fp8과 fp4가 섞여 있어 고정하지 않으면 명세서 품질이 조용히 갈린다.
        //
        // [주의] 이 값은 아래 두 모델을 전제로 고른 것이다.
        //     Actor/Consolidator = z-ai/glm-5.2, Critic = deepseek/deepseek-v4-pro-0813
        //   Routing은 provider 단위 설정이라 세 역할이 이 목록 하나를 공유하고,
        //   목록에서 "그 모델을 서빙하는 첫 백엔드"가 뽑힌다. 모델을 바꾸면 여기도
        //   다시 골라야 한다 - AllowFallbacks가 false라 목록의 어느 백엔드도 그 모델을
        //   서빙하지 않으면 404 "No endpoints found"로 즉시 실패한다.
        //   (실측: glm 최저가인 sail-research는 deepseek를 서빙하지 않아 Critic이 죽는다)
        //
        //   다시 고를 때는 후보와 단가를 먼저 조회한다:
        //     curl -H "Authorization: Bearer $KEY" \
        //       https://openrouter.ai/api/v1/models/<author>/<slug>/endpoints
        //   두 모델 모두를 서빙하면서 input_cache_read 단가가 낮은 곳을 고르면 된다.
        //   정상 상태 비용은 입력 단가가 아니라 캐시 읽기 단가가 지배한다.
        //
        // 고정을 쓰지 않으려면 이 구획을 통째로 지우거나 항목을 다시 비운다.
        // 그러면 요청에 provider 필드를 넣지 않아 OpenRouter 기본 라우팅으로 돈다.
        "Routing": {
          // 1순위 digitalocean: 두 모델을 모두 서빙하고 캐시 읽기 단가가 가장 낮다
          //   (glm $0.10/M · deepseek $0.04/M). 2순위 streamlake: 1순위가 막혔을 때
          //   fp4 백엔드로 조용히 떨어지지 않게 하는 안전망이고, glm 컨텍스트가
          //   1,024,000이라 262,144인 digitalocean이 못 받는 대형 SP도 받는다.
          "Order": [ "digitalocean", "streamlake" ],
          // false 권장. true로 두면 위 둘이 막혔을 때 fp4 양자화 백엔드로 넘어가
          // 품질이 말없이 갈린다. false면 명시적으로 실패하고, L2 리뷰 호출은
          // AiCallRetry가 429·5xx를 일시적 실패로 보고 다시 부른다.
          "AllowFallbacks": false,
          // 비워 두는 것을 권장. 켜면 요청 파라미터를 모두 지원하는 곳으로 후보가
          // 더 좁혀져 위 둘이 함께 배제될 수 있다.
          "RequireParameters": null
        }
      },
      // CLI 제공자는 ApiKey 없이 Command만 씁니다. 모델은 여기가 아니라 AiSettings:ModelName이
      // 아래 인자로 전달됩니다.
      "claude-cli": {
        "Command": "claude"            // Claude Code CLI 명령어. PATH에 없으면 절대 경로 지정. API 키 불필요(CLI 로그인 계정 사용). 모델은 --model 인자로 전달
      },
      "codex-cli": {
        "Command": "codex"             // Codex CLI 명령어. 모델은 -m 인자로 전달
      },
      "agy-cli": {
        "Command": "agy"               // Antigravity CLI 명령어. 모델은 --model 인자로 전달. 프롬프트를 명령행으로 넘기므로 Windows에서 32KB를 넘는 대형 SP는 처리할 수 없음
      }
    }
  },
  "ValidationSettings": {
    "TargetLanguage": "C#"               // 검증 대상 언어 ("Auto" | "C#" | "Java")
  }
}
